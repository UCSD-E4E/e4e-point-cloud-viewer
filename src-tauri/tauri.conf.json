{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E4E Point Cloud Viewer",
  "version": "0.1.0",
  "identifier": "io.e4e.pointcloudviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "E4E Point Cloud Viewer",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
